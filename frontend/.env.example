# Backend root URL. Leave empty for same-origin requests (dev server and
# Docker nginx proxy both forward /v1 and /health to the backend — the
# supported layouts, since the backend serves no CORS headers).
VITE_API_BASE=

# Optional bearer token sent as `Authorization: Bearer <key>`.
# Leave unset for local dev against an unauthenticated backend.
VITE_API_KEY=

# Dev-only: target for the Vite dev-server proxy (not bundled into the app).
PROXY_TARGET=http://localhost:8000
