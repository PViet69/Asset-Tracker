server {
    listen 80;
    server_name _;

    # Match the backend's MAX_REQUEST_SIZE (250 MB) so nginx does not
    # truncate multipart uploads before the app applies its own limit.
    client_max_body_size 250m;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback
    location / {
        try_files $uri /index.html;
    }

    # Proxy API routes to the backend service (same-origin for the browser,
    # so no CORS configuration is needed on the backend). When
    # UPLOAD_API_KEY is set, the bearer header is injected here — the key
    # never reaches the browser bundle.
    location /v1/ {
        proxy_pass http://app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization "Bearer ${UPLOAD_API_KEY}";
    }

    location = /health {
        proxy_pass http://app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
