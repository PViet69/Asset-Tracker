APP_PORT=8000
QDRANT_PORT=6333
# Base URL must include /v1 for OpenAI-compatible endpoints (Ollama, vLLM, etc.)
MODEL_ENDPOINT_URL=http://host.docker.internal:8001/v1
MODEL_ENDPOINT_API_KEY=
MODEL_REQUEST_TIMEOUT=30
DESCRIPTION_MODEL=replace-with-vision-model
# Base URL only — SDK appends /chat/completions. Trailing path causes 404.
DESCRIPTION_ENDPOINT_URL=http://host.docker.internal:8001/v1
DESCRIPTION_ENDPOINT_API_KEY=
EMBEDDING_MODEL=replace-with-text-embedding-model
UPLOAD_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=file_embeddings
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE=Cosine
# Required to use POST /v1/search. Minimum cosine similarity (0-1) for hits.
SEARCH_THRESHOLD=